<div class="sidebar d-flex flex-column flex-shrink-0 p-3 bg-white" style="width: 220px; border-right: 1px solid #f0e6ed; overflow-y: auto;">

  <ul class="nav nav-pills flex-column mb-auto gap-1 mt-2">

    <% if current_user.admin? %>
      <li class="nav-item">
        <a href="/admin/dashboard" class="nav-link <%= 'active' if controller_name == 'admin' && action_name == 'index' %>">
          <i class="fa-solid fa-user-shield me-2"></i> Admin Panel
        </a>
      </li>
      <li>
        <%= link_to admin_users_path, class: "nav-link #{'active' if action_name == 'users'}" do %>
          <i class="fa-solid fa-users me-2"></i> Manage Users
        <% end %>
      </li>
      <li>
        <%= link_to admin_stats_path, class: "nav-link #{'active' if action_name == 'stats'}" do %>
          <i class="fa-solid fa-chart-line me-2"></i> Population Stats
        <% end %>
      </li>
    <% else %>
      <li class="nav-item">
        <a href="/" class="nav-link <%= 'active' if controller_name == 'dashboard' %>">
          <i class="fa-solid fa-house me-2"></i> Dashboard
        </a>
      </li>
      <li>
        <%= link_to heart_rate_logs_path, class: "nav-link #{'active' if controller_name == 'heart_rate_logs'}" do %>
          <i class="fa-solid fa-notes-medical me-2"></i> My Logs
        <% end %>
      </li>
      <li>
        <%= link_to edit_profile_path, class: "nav-link #{'active' if controller_name == 'profiles'}" do %>
          <i class="fa-solid fa-user-doctor me-2"></i> Health Profile
        <% end %>
      </li>
    <% end %>

    <hr class="my-3">

    <li>
      <%= link_to settings_path, class: "nav-link #{'active' if controller_name == 'settings'}" do %>
        <i class="fa-solid fa-gear me-2"></i> Settings
      <% end %>
    </li>
  </ul>


</div>