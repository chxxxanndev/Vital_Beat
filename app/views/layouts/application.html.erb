<!DOCTYPE html>
<html>
  <head>
    <title>HRLsys | Heart Rate Log</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
      @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');

      *, *::before, *::after { box-sizing: border-box; }

      html, body {
        height: 100%;
        margin: 0;
        font-family: 'Inter', sans-serif;
        background-color: #f0f4f8;
      }

      /* ── Split layout ── */
      .split-container {
        height: 100vh;
        display: flex;
        overflow: hidden;
      }

      .brand-side {
        flex: 1.2;
        background: linear-gradient(145deg, #2d1b4e 0%, #4a1c6e 50%, #7b2d5e 100%);
        color: white;
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 80px;
        position: relative;
        overflow: hidden;
      }

      /* Animated background blobs */
      .brand-side::before,
      .brand-side::after {
        content: '';
        position: absolute;
        border-radius: 50%;
        opacity: 0.12;
        animation: blobFloat 8s ease-in-out infinite;
      }
      .brand-side::before {
        width: 400px; height: 400px;
        background: white;
        top: -100px; right: -100px;
        animation-delay: 0s;
      }
      .brand-side::after {
        width: 300px; height: 300px;
        background: #e57373;
        bottom: -80px; left: -80px;
        animation-delay: 3s;
      }
      @keyframes blobFloat {
        0%, 100% { transform: translate(0, 0) scale(1); }
        50% { transform: translate(20px, -20px) scale(1.05); }
      }

      .brand-content { position: relative; z-index: 1; }

      /* ── Form side ── */
      .form-side {
        flex: 1;
        background: white;
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 60px;
      }

      .form-container { max-width: 400px; width: 100%; margin: 0 auto; }

      /* ── Input styling ── */
      .form-control {
        border: 1.5px solid #e2e8f0;
        border-radius: 10px;
        padding: 12px 16px;
        font-size: 0.95rem;
        background: #f8fafc;
        transition: border-color 0.2s, box-shadow 0.2s, transform 0.15s;
      }
      .form-control:focus {
        border-color: #7b2d5e;
        box-shadow: 0 0 0 3px rgba(123, 45, 94, 0.12);
        background: white;
        transform: translateY(-1px);
        outline: none;
      }

      /* This makes the icon sit inside the input box */
      .password-toggle-icon {
        position: absolute;
        right: 15px;
        top: 50%;
        transform: translateY(-50%);
        cursor: pointer;
        color: #94a3b8;
        font-size: 0.9rem;
        z-index: 10;
        transition: color 0.2s;
      }

      .password-toggle-icon:hover {
        color: #0f172a;
      }

      /* Adds space so the password dots don't go under the eye icon */
      .form-control.pe-5 {
        padding-right: 40px !important;
      }

      /* ── Primary button ── */
      .btn-primary-custom {
        background: linear-gradient(135deg, #4a1c6e, #7b2d5e);
        border: none;
        border-radius: 10px;
        padding: 14px;
        font-size: 1rem;
        font-weight: 600;
        color: white;
        width: 100%;
        cursor: pointer;
        transition: transform 0.2s, box-shadow 0.2s, opacity 0.2s;
        position: relative;
        overflow: hidden;
      }
      .btn-primary-custom::after {
        content: '';
        position: absolute;
        inset: 0;
        background: white;
        opacity: 0;
        transition: opacity 0.2s;
      }
      .btn-primary-custom:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(123, 45, 94, 0.35);
      }
      .btn-primary-custom:active { transform: translateY(0); }

      /* ── Fade-in animations ── */
      @keyframes fadeInUp {
        from { opacity: 0; transform: translateY(24px); }
        to   { opacity: 1; transform: translateY(0); }
      }
      @keyframes fadeInLeft {
        from { opacity: 0; transform: translateX(-30px); }
        to   { opacity: 1; transform: translateX(0); }
      }
      @keyframes fadeInRight {
        from { opacity: 0; transform: translateX(30px); }
        to   { opacity: 1; transform: translateX(0); }
      }

      .anim-left  { animation: fadeInLeft  0.65s cubic-bezier(.22,.68,0,1.2) both; }
      .anim-right { animation: fadeInRight 0.65s cubic-bezier(.22,.68,0,1.2) both; }
      .anim-up    { animation: fadeInUp    0.5s  cubic-bezier(.22,.68,0,1.2) both; }

      .delay-1 { animation-delay: 0.1s; }
      .delay-2 { animation-delay: 0.2s; }
      .delay-3 { animation-delay: 0.3s; }
      .delay-4 { animation-delay: 0.4s; }
      .delay-5 { animation-delay: 0.5s; }
      .delay-6 { animation-delay: 0.6s; }

      /* ── ECG / heartbeat line animation ── */
      .ecg-line {
        width: 100%;
        max-width: 280px;
        height: 48px;
        margin: 28px 0;
      }
      .ecg-path {
        stroke: rgba(255,255,255,0.7);
        stroke-width: 2;
        fill: none;
        stroke-dasharray: 600;
        stroke-dashoffset: 600;
        animation: drawLine 2s ease forwards 0.8s, ecgLoop 3s linear infinite 2.8s;
      }
      @keyframes drawLine {
        to { stroke-dashoffset: 0; }
      }
      @keyframes ecgLoop {
        0%   { stroke-dashoffset: 0; opacity: 1; }
        80%  { stroke-dashoffset: 0; opacity: 1; }
        100% { stroke-dashoffset: -600; opacity: 0.5; }
      }

      /* ── Pulse icon ── */
      .icon-pulse {
        font-size: 3rem;
        animation: iconPulse 2.2s ease-in-out infinite;
      }
      @keyframes iconPulse {
        0%, 100% { transform: scale(1);    opacity: 0.9; }
        50%       { transform: scale(1.12); opacity: 1;   }
      }

      /* ── Feature list ── */
      .feature-item {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 14px;
        font-size: 0.95rem;
        opacity: 0.9;
      }
      .feature-dot {
        width: 22px; height: 22px;
        border-radius: 50%;
        background: rgba(255,255,255,0.25);
        display: flex; align-items: center; justify-content: center;
        flex-shrink: 0;
        font-size: 11px;
      }

      /* ── Label ── */
      .field-label {
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        color: #64748b;
        text-transform: uppercase;
        margin-bottom: 6px;
        display: block;
      }

      /* ── Shake error ── */
      @keyframes shake {
        0%, 100% { transform: translateX(0); }
        20%       { transform: translateX(-8px); }
        40%       { transform: translateX(8px); }
        60%       { transform: translateX(-6px); }
        80%       { transform: translateX(6px); }
      }
      .shake { animation: shake 0.4s ease; }

      /* ── Navbar ── */
      .hrl-navbar {
        background: white;
        border-bottom: 1px solid #e2e8f0;
        padding: 14px 0;
      }
      .hrl-navbar .brand {
        font-weight: 700;
        font-size: 1.1rem;
        color: #7b2d5e;
        text-decoration: none;
      }
      .hrl-navbar .brand i { margin-right: 6px; }

      /* ── Link ── */
      .link-blue { color: #7b2d5e; font-weight: 600; text-decoration: none; }
      .link-blue:hover { text-decoration: underline; }

      @media (max-width: 768px) {
        .brand-side { display: none; }
        .form-side { padding: 40px 24px; }
      }
    </style>
  </head>

  <body>
    <% unless ['users', 'sessions'].include?(controller_name) %>
      <nav class="hrl-navbar shadow-sm">
        <div class="container d-flex align-items-center justify-content-between">
          <a class="brand" href="/"><i class="fa-solid fa-heart-pulse"></i>HRLsys</a>
          <% if current_user %>
            <span class="text-muted small">
              <%= current_user.email %> &nbsp;|&nbsp;
              <%= link_to "Logout", logout_path, class: "link-blue" %>
            </span>
          <% end %>
        </div>
      </nav>
    <% end %>

    <%= yield %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
      function togglePassword(inputId, icon) {
        const input = document.getElementById(inputId);
        if (input.type === "password") {
          input.type = "text";
          icon.classList.replace('fa-eye', 'fa-eye-slash');
        } else {
          input.type = "password";
          icon.classList.replace('fa-eye-slash', 'fa-eye');
        }
      }
    </script>

  </body>
</html>