<!DOCTYPE html>
<html>
  <head>
    <title>HRLsys | Heart Rate Log</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
      @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;1,600&family=Inter:wght@300;400;500;600;700&display=swap');
      @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');

      *, *::before, *::after { box-sizing: border-box; }

      html, body {
        height: 100%;
        margin: 0;
        font-family: 'Inter', sans-serif;
        background-color: #f0f4f8;
      }

      .split-container {
        height: 100vh;
        display: flex;
        overflow: hidden;
      }

      .brand-side {
        flex: 1.2;
        background: linear-gradient(145deg, #2d1b4e 0%, #4a1c6e 50%, #7b2d5e 100%);
        color: white;
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 80px;
        position: relative;
        overflow: hidden;
      }

      .brand-side::before,
      .brand-side::after {
        content: '';
        position: absolute;
        border-radius: 50%;
        opacity: 0.12;
        animation: blobFloat 8s ease-in-out infinite;
      }
      .brand-side::before {
        width: 400px; height: 400px;
        background: white;
        top: -100px; right: -100px;
        animation-delay: 0s;
      }
      .brand-side::after {
        width: 300px; height: 300px;
        background: #e57373;
        bottom: -80px; left: -80px;
        animation-delay: 3s;
      }
      @keyframes blobFloat {
        0%, 100% { transform: translate(0, 0) scale(1); }
        50% { transform: translate(20px, -20px) scale(1.05); }
      }

      .brand-content { position: relative; z-index: 1; }

      .form-side {
        flex: 1;
        background: white;
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
        padding: 60px 40px;
        overflow-y: auto;
      }
      .form-container {
        max-width: 400px;
        width: 100%;
        margin: auto;
      }

      .field-label {
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        color: #64748b;
        margin-bottom: 8px;
        display: block;
        letter-spacing: 0.05em;
      }

      .form-control {
        border: 1.5px solid #e2e8f0;
        border-radius: 10px;
        padding: 12px 16px;
        font-size: 0.95rem;
        background: #f8fafc;
        transition: border-color 0.2s, box-shadow 0.2s, transform 0.15s;
      }
      .form-control:focus {
        border-color: #7b2d5e;
        box-shadow: 0 0 0 3px rgba(123, 45, 94, 0.12);
        background: white;
        transform: translateY(-1px);
        outline: none;
      }

      .password-toggle-icon {
        position: absolute;
        right: 15px;
        top: 50%;
        transform: translateY(-50%);
        cursor: pointer;
        color: #94a3b8;
        font-size: 0.9rem;
        z-index: 10;
        transition: color 0.2s;
      }
      .password-toggle-icon:hover { color: #0f172a; }

      .home-wrap {
        max-width: 1100px;
        margin: 0 auto;
        padding: 28px 24px;
      }

      .home-topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 24px;
        flex-wrap: wrap;
        gap: 12px;
      }
      .home-greeting {
        font-size: 0.85rem;
        color: #94a3b8;
        margin: 0;
        font-weight: 500;
        letter-spacing: 0.04em;
        text-transform: uppercase;
      }
      .home-name {
        font-size: 2rem;
        font-weight: 700;
        color: #1e293b;
        margin: 0;
        line-height: 1.2;
      }
      .home-topbar-actions {
        display: flex;
        gap: 10px;
        align-items: center;
      }

      .home-btn-primary {
        background: linear-gradient(135deg, #4a1c6e, #7b2d5e);
        color: white;
        border: none;
        border-radius: 8px;
        padding: 9px 18px;
        font-size: 0.88rem;
        font-weight: 600;
        text-decoration: none;
        display: inline-block;
        transition: transform 0.2s, box-shadow 0.2s;
      }
      .home-btn-primary:hover {
        transform: translateY(-1px);
        box-shadow: 0 6px 16px rgba(123, 45, 94, 0.3);
        color: white;
      }
      .home-btn-ghost {
        background: transparent;
        color: #7b2d5e;
        border: 1.5px solid #e9d5e2;
        border-radius: 8px;
        padding: 9px 18px;
        font-size: 0.88rem;
        font-weight: 600;
        text-decoration: none;
        display: inline-block;
        transition: background 0.2s, border-color 0.2s;
      }
      .home-btn-ghost:hover {
        background: #fdf2f8;
        border-color: #d8b4c8;
        color: #7b2d5e;
      }

      .home-stats {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 14px;
        margin-bottom: 20px;
      }
      .home-stat-card {
        background: white;
        border-radius: 12px;
        border: 1px solid #f0e6ed;
        padding: 18px;
        display: flex;
        align-items: center;
        gap: 14px;
        transition: box-shadow 0.2s, transform 0.2s;
      }
      .home-stat-card:hover {
        box-shadow: 0 6px 20px rgba(123,45,94,0.1);
        transform: translateY(-2px);
      }
      .home-stat-icon {
        width: 44px; height: 44px;
        border-radius: 10px;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.1rem;
        flex-shrink: 0;
      }
      .home-stat-label {
        font-size: 0.72rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: #94a3b8;
        margin: 0 0 4px;
      }
      .home-stat-val {
        font-size: 1.5rem;
        font-weight: 700;
        color: #1e293b;
        margin: 0;
        line-height: 1;
      }
      .home-stat-unit {
        font-size: 0.75rem;
        font-weight: 500;
        color: #94a3b8;
      }

      .home-grid {
        display: grid;
        grid-template-columns: 1fr 300px;
        gap: 16px;
      }
      @media (max-width: 900px) { .home-grid { grid-template-columns: 1fr; } }

      .home-card {
        background: white;
        border-radius: 12px;
        border: 1px solid #f0e6ed;
        padding: 20px;
        transition: box-shadow 0.2s;
      }
      .home-card:hover { box-shadow: 0 4px 18px rgba(123,45,94,0.07); }
      .home-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 16px;
      }
      .home-card-title {
        font-size: 0.95rem;
        font-weight: 700;
        color: #1e293b;
        margin: 0;
      }

      .home-welcome-body {
        text-align: center;
        padding: 30px 20px;
      }
      .home-welcome-illustration {
        width: 72px; height: 72px;
        background: linear-gradient(135deg, #f3e8ff, #fce7f3);
        border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        font-size: 2rem;
        color: #7b2d5e;
        margin: 0 auto 16px;
        animation: iconPulse 2.2s ease-in-out infinite;
      }
      .home-welcome-heading {
        font-size: 1.2rem;
        font-weight: 700;
        color: #1e293b;
        margin-bottom: 10px;
      }
      .home-welcome-sub {
        font-size: 0.88rem;
        color: #64748b;
        line-height: 1.6;
        max-width: 420px;
        margin: 0 auto 20px;
      }
      .home-welcome-badges {
        display: flex;
        gap: 8px;
        justify-content: center;
        flex-wrap: wrap;
      }
      .home-badge {
        background: #f3e8ff;
        color: #7b2d5e;
        font-size: 0.75rem;
        font-weight: 600;
        padding: 5px 12px;
        border-radius: 20px;
      }
      .home-badge-green {
        background: #ecfdf5;
        color: #065f46;
        font-size: 0.75rem;
        font-weight: 600;
        padding: 4px 10px;
        border-radius: 20px;
        display: inline-flex;
        align-items: center;
      }

      .home-account-avatar {
        width: 52px; height: 52px;
        border-radius: 50%;
        background: linear-gradient(135deg, #4a1c6e, #7b2d5e);
        color: white;
        font-size: 1.3rem;
        font-weight: 700;
        display: flex; align-items: center; justify-content: center;
        margin: 0 auto 16px;
        box-shadow: 0 4px 12px rgba(123,45,94,0.25);
      }

      .home-account-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 9px 0;
        border-bottom: 1px solid #fdf2f8;
        gap: 12px;
      }
      .home-account-label {
        font-size: 0.78rem;
        color: #94a3b8;
        font-weight: 500;
        flex-shrink: 0;
      }
      .home-account-val {
        font-size: 0.82rem;
        font-weight: 600;
        color: #1e293b;
        text-align: right;
        word-break: break-all;
      }

      .home-bpm-row {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 7px 0;
        border-bottom: 1px solid #fdf2f8;
        font-size: 0.85rem;
      }
      .home-bpm-row:last-child { border-bottom: none; }
      .home-bpm-dot {
        width: 9px; height: 9px;
        border-radius: 50%;
        flex-shrink: 0;
      }
      .home-bpm-label {
        font-weight: 600;
        color: #374151;
        flex: 1;
      }
      .home-bpm-range {
        color: #94a3b8;
        font-size: 0.8rem;
      }

      .greeting-banner {
        position: relative;
        border-radius: 16px;
        overflow: hidden;
        padding: 28px 28px;
      }

      .greeting-banner-bg {
        position: absolute;
        inset: 0;
        background: linear-gradient(270deg, #2d1b4e, #4a1c6e, #7b2d5e, #9d3570, #7b2d5e, #4a1c6e, #2d1b4e);
        background-size: 400% 400%;
        animation: bannerShift 8s ease infinite;
        z-index: 0;
      }

      .greeting-banner-content {
        position: relative;
        z-index: 1;
      }

      @keyframes bannerShift {
        0%   { background-position: 0% 50%; }
        50%  { background-position: 100% 50%; }
        100% { background-position: 0% 50%; }
      }

      .sidebar .nav-link {
        color: #4a1c6e;
        transition: transform 0.15s ease, background 0.2s ease, color 0.2s ease;
      }
      .sidebar .nav-link:hover {
        background: linear-gradient(135deg, #4a1c6e, #7b2d5e);
        color: white;
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(123, 45, 94, 0.35);
      }
      .sidebar .nav-link.active {
        background: linear-gradient(135deg, #4a1c6e, #7b2d5e);
        color: white;
      }

      .sidebar .nav-link.text-danger:hover {
        background: transparent;
        color: #e11d48 !important;
        transform: none;
      }

      .fw-bold.text-dark.fs-5 {
        font-family: 'DM Mono', monospace; /* Or just 'Courier New' */
        letter-spacing: -0.02em;
      }

      .form-control.pe-5 { padding-right: 40px !important; }

      .btn-primary-custom {
        background: linear-gradient(135deg, #4a1c6e, #7b2d5e);
        border: none;
        border-radius: 10px;
        padding: 14px;
        font-size: 1rem;
        font-weight: 600;
        color: white;
        width: 100%;
        cursor: pointer;
        transition: transform 0.2s, box-shadow 0.2s, opacity 0.2s;
        position: relative;
        overflow: hidden;
      }
      .btn-primary-custom:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(123, 45, 94, 0.35);
      }
      .btn-primary-custom:active { transform: translateY(0); }

      @keyframes fadeInUp {
        from { opacity: 0; transform: translateY(24px); }
        to   { opacity: 1; transform: translateY(0); }
      }
      @keyframes fadeInLeft {
        from { opacity: 0; transform: translateX(-30px); }
        to   { opacity: 1; transform: translateX(0); }
      }
      @keyframes fadeInRight {
        from { opacity: 0; transform: translateX(30px); }
        to   { opacity: 1; transform: translateX(0); }
      }

      .anim-left  { animation: fadeInLeft  0.65s cubic-bezier(.22,.68,0,1.2) both; }
      .anim-right { animation: fadeInRight 0.65s cubic-bezier(.22,.68,0,1.2) both; }
      .anim-up    { animation: fadeInUp    0.5s  cubic-bezier(.22,.68,0,1.2) both; }

      .delay-1 { animation-delay: 0.1s; }
      .delay-2 { animation-delay: 0.2s; }
      .delay-3 { animation-delay: 0.3s; }
      .delay-4 { animation-delay: 0.4s; }
      .delay-5 { animation-delay: 0.5s; }
      .delay-6 { animation-delay: 0.6s; }

      .ecg-line {
        width: 100%;
        max-width: 280px;
        height: 48px;
        margin: 28px 0;
      }
      .ecg-path {
        stroke: rgba(255,255,255,0.7);
        stroke-width: 2;
        fill: none;
        stroke-dasharray: 600;
        stroke-dashoffset: 600;
        animation: drawLine 2s ease forwards 0.8s, ecgLoop 3s linear infinite 2.8s;
      }
      @keyframes drawLine { to { stroke-dashoffset: 0; } }
      @keyframes ecgLoop {
        0%   { stroke-dashoffset: 0; opacity: 1; }
        80%  { stroke-dashoffset: 0; opacity: 1; }
        100% { stroke-dashoffset: -600; opacity: 0.5; }
      }

      .icon-pulse {
        font-size: 3rem;
        animation: iconPulse 2.2s ease-in-out infinite;
      }
      @keyframes iconPulse {
        0%, 100% { transform: scale(1);    opacity: 0.9; }
        50%       { transform: scale(1.12); opacity: 1;   }
      }

      .navbar-tagline-cycler {
  position: relative;
  height: 60px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.navbar-tagline {
  font-family: 'Playfair Display', serif;
  font-size: 0.92rem;
  font-weight: 600;
  font-style: italic;
  letter-spacing: 0.02em;
  white-space: nowrap;
  position: absolute;
  opacity: 0;
  transform: translateY(20px) scale(0.95);
  transition: none;
  background: linear-gradient(135deg, #4a1c6e, #7b2d5e);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  pointer-events: none;
}

.navbar-tagline.active {
  animation: taglineBounceIn 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
}

.navbar-tagline.exit {
  animation: taglineBounceOut 0.4s ease-in forwards;
}

@keyframes taglineBounceIn {
  0%   { opacity: 0; transform: translateY(24px) scale(0.9); }
  60%  { opacity: 1; transform: translateY(-6px) scale(1.04); }
  80%  { transform: translateY(3px) scale(0.98); }
  100% { opacity: 1; transform: translateY(0) scale(1); }
}

@keyframes taglineBounceOut {
  0%   { opacity: 1; transform: translateY(0) scale(1); }
  100% { opacity: 0; transform: translateY(-20px) scale(0.9); }
}

      .feature-item {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 14px;
        font-size: 0.95rem;
        opacity: 0.9;
      }
      .feature-dot {
        width: 22px; height: 22px;
        border-radius: 50%;
        background: rgba(255,255,255,0.25);
        display: flex; align-items: center; justify-content: center;
        flex-shrink: 0;
        font-size: 11px;
      }

      @keyframes shake {
        0%, 100% { transform: translateX(0); }
        20%       { transform: translateX(-8px); }
        40%       { transform: translateX(8px); }
        60%       { transform: translateX(-6px); }
        80%       { transform: translateX(6px); }
      }
      .shake { animation: shake 0.4s ease; }

      .hrl-navbar {
        background: white;
        border-bottom: 1px solid #e2e8f0;
        padding: 14px 0;
      }
      .hrl-navbar .brand {
        font-weight: 700;
        font-size: 1.1rem;
        color: #7b2d5e;
        text-decoration: none;
      }
      .hrl-navbar .brand i { margin-right: 6px; }

      .link-blue { color: #7b2d5e; font-weight: 600; text-decoration: none; }
      .link-blue:hover { text-decoration: underline; }

      /* Navbar */
      .vb-navbar {
        background: white;
        border-bottom: 2px solid #f0e6ed;
        height: 60px;
        flex-shrink: 0;
      }

      /* Footer */
      .vb-footer {
        background: white;
        font-size: 0.75rem;
        color: #aaa;
        flex-shrink: 0;
      }

      @media (max-width: 768px) {
        .brand-side { display: none; }
        .form-side { padding: 40px 24px; }
      }
    </style>
  </head>

<body class="<%= 'no-scroll' if ['users', 'sessions', 'password_resets'].include?(controller_name) %>">

  <% if ['users', 'sessions', 'password_resets'].include?(controller_name) %>
    <%= yield %>

  <% else %>
    <div class="d-flex flex-column" style="height: 100vh; overflow: hidden;">
      <%= render "layouts/navbar" %>

      <div class="d-flex flex-grow-1" style="overflow: hidden;">
        <%= render "layouts/sidebar" %>

        <main class="flex-grow-1 p-4 overflow-auto" style="background-color: #f8fafc;">
        

          <%= yield %>
          <%= render "layouts/footer" %>
        </main>
      </div>
    </div>
  <% end %>

  <div class="modal fade" id="confirmDeleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
        <form id="modal-form" method="post" action="#">
          <input type="hidden" name="authenticity_token" id="modal-csrf-token" value="">
          <input type="hidden" name="_method" id="modal-method-input" value="">
          <input type="hidden" id="modal-extra-input" name="" value="">

          <div class="modal-header border-0 pb-0">
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body text-center p-4">
            <div class="d-inline-block p-3 rounded-circle mb-3" style="background: #fff1f2;">
              <i class="fa-solid fa-circle-exclamation fa-2x text-danger"></i>
            </div>
            <h4 class="fw-bold text-dark" id="modal-title">Confirm Action</h4>
            <p class="text-muted" id="modal-message">Are you sure?</p>
          </div>
          <div class="modal-footer border-0 p-4 pt-0 d-flex gap-2">
            <button type="button" class="btn btn-light flex-grow-1 rounded-3 fw-bold" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" id="modal-confirm-button" class="btn btn-danger flex-grow-1 rounded-3 fw-bold shadow-sm">Confirm</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

  <script>
    function togglePassword(inputId, icon) {
      const input = document.getElementById(inputId);
      if (input.type === "password") {
        input.type = "text";
        icon.classList.replace('fa-eye', 'fa-eye-slash');
      } else {
        input.type = "password";
        icon.classList.replace('fa-eye-slash', 'fa-eye');
      }
    }

    function openConfirmModal(url, method, title, message, btnText, extraName = null, extraValue = null) {
      const form = document.getElementById('modal-form');
      const csrfInput = document.getElementById('modal-csrf-token');
      const methodInput = document.getElementById('modal-method-input');
      const extraInput = document.getElementById('modal-extra-input');
      const titleEl = document.getElementById('modal-title');
      const messageEl = document.getElementById('modal-message');
      const buttonEl = document.getElementById('modal-confirm-button');

      const csrfToken = document.querySelector('meta[name="csrf-token"]').getAttribute('content');

      form.action = url;
      csrfInput.value = csrfToken;
      methodInput.value = method.toLowerCase();
      titleEl.innerText = title;
      messageEl.innerText = message;
      buttonEl.innerText = btnText;

      if (extraName) {
        extraInput.name = extraName;
        extraInput.value = extraValue;
      } else {
        extraInput.name = '';
        extraInput.value = '';
      }

      new bootstrap.Modal(document.getElementById('confirmDeleteModal')).show();
    }

    setTimeout(() => {
      document.querySelectorAll('.alert').forEach(alert => {
        new bootstrap.Alert(alert).close();
      });
    }, 5000);

    // Navbar tagline cycler
    const taglines = document.querySelectorAll('.navbar-tagline');
    if (taglines.length > 0) {
      let current = 0;
      setInterval(() => {
        taglines[current].classList.remove('active');
        taglines[current].classList.add('exit');
        setTimeout(() => {
          taglines[current].classList.remove('exit');
          current = (current + 1) % taglines.length;
          taglines[current].classList.add('active');
        }, 400);
      }, 3000);
    }
  </script>

</body>
</html>