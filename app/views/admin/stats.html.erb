<div class="home-wrap animate__animated animate__fadeIn">
  <div class="home-topbar">
    <div>
      <p class="home-greeting">Analytical Insights</p>
      <h1 class="home-name">Population Stats</h1>
    </div>
  </div>

  <!-- Population Overview Cards -->
  <div class="home-stats mb-4">
    <div class="home-stat-card shadow-sm border-0">
      <div class="home-stat-icon bg-success bg-opacity-10 text-success">
        <i class="fa-solid fa-heart-pulse"></i>
      </div>
      <div>
        <p class="home-stat-label">System Avg BPM</p>
        <p class="home-stat-val text-dark"><%= @avg_bpm %> <small class="home-stat-unit">bpm</small></p>
      </div>
    </div>

    <div class="home-stat-card shadow-sm border-0">
      <div class="home-stat-icon bg-purple bg-opacity-10" style="color: #6d28d9;">
        <i class="fa-solid fa-database"></i>
      </div>
      <div>
        <p class="home-stat-label">Total Data Points</p>
        <p class="home-stat-val text-dark"><%= @total_logs %></p>
      </div>
    </div>
  </div>

  <div class="row">
    <!-- Zone Distribution -->
    <div class="col-md-6 mb-4">
      <div class="home-card shadow-sm border-0 rounded-4 h-100">
        <h5 class="fw-bold mb-4 text-dark"><i class="fa-solid fa-chart-pie me-2 text-primary"></i>Health Zone Distribution</h5>
        <div class="d-flex flex-column gap-3">
          <% ["Resting", "Fat Burn", "Cardio", "Peak", "Maximum"].each do |zone| %>
            <% count = @zone_counts[zone] || 0 %>
            <% percent = @total_logs > 0 ? (count.to_f / @total_logs * 100).round : 0 %>
            <div>
              <div class="d-flex justify-content-between mb-1 small fw-bold">
                <span><%= zone %></span>
                <span class="text-muted"><%= count %> entries (<%= percent %>%)</span>
              </div>
              <div class="progress" style="height: 8px; background-color: #f1f5f9;">
                <div class="progress-bar" style="width: <%= percent %>%; background-color: <%= zone_color(zone) %>"></div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Activity Type Summary -->
    <div class="col-md-6 mb-4">
      <div class="home-card shadow-sm border-0 rounded-4 h-100">
        <h5 class="fw-bold mb-4 text-dark"><i class="fa-solid fa-person-running me-2 text-primary"></i>Activity Context Analysis</h5>
        <table class="table table-borderless table-sm mb-0 align-middle">
          <tbody>
            <% @status_counts.each do |status, count| %>
              <tr>
                <td class="ps-0 py-2 fw-semibold text-muted"><%= status %></td>
                <td class="text-end py-2">
                  <span class="badge bg-light text-dark rounded-pill px-3"><%= count %> logs</span>
                </td>
              </tr>
            <% end %>
            <% if @status_counts.empty? %>
               <tr><td class="text-center py-4 text-muted">No activity data recorded yet.</td></tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>