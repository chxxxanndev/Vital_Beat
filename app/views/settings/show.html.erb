<div class="home-wrap animate__animated animate__fadeIn">
  <div class="home-topbar">
    <div>
      <p class="home-greeting">Security Hub</p>
      <h1 class="home-name">Settings</h1>
    </div>
  </div>

  <!-- 1. Credentials Card -->
  <div class="home-card shadow-sm border-0 rounded-4 p-4 mb-4">
    <h4 class="fw-bold mb-4"><i class="fa-solid fa-shield-halved me-2 text-primary"></i>Security Credentials</h4>
    
    <%= form_with model: current_user, url: settings_path, method: :patch do |f| %>
      <div class="mb-3">
        <label class="field-label">Current Password</label>
        <%= password_field_tag :current_password, nil, class: "form-control", placeholder: "Confirm identity to save changes" %>
      </div>

      <div class="row">
        <div class="col-md-6 mb-3">
          <label class="field-label">New Password</label>
          <%= f.password_field :password, class: "form-control", placeholder: "Min 6 characters" %>
        </div>
        <div class="col-md-6 mb-3">
          <label class="field-label">Confirm New Password</label>
          <%= f.password_field :password_confirmation, class: "form-control" %>
        </div>
      </div>

      <div class="mt-3">
        <%= f.submit "Update Password", class: "home-btn-primary" %>
      </div>
    <% end %>
  </div>

  <% unless current_user.admin? %>
    <div class="home-card border-warning border-opacity-25 rounded-4 p-4 mt-4 animate__animated animate__fadeInUp" style="background-color: #fffbeb;">
      <h5 class="fw-bold text-warning mb-2" style="color: #854f0b !important;">Account Management</h5>
      <p class="small text-muted mb-4">
        <strong>Archive Your Account:</strong> By deactivating, your secure access to VitalBeat will be revoked, but your medical history and heart rate logs will be preserved in our database for future clinical review. You can reactivate your account at any time via a secure password reset.
      </p>

      <div class="d-flex flex-wrap gap-3">
        <!-- ONLY THE DEACTIVATE BUTTON REMAINS -->
        <button type="button" class="btn btn-warning btn-sm rounded-3 px-4 fw-bold text-white" style="background-color: #f59e0b; border: none;"
                onclick="openConfirmModal('<%= deactivate_settings_path %>', 'PATCH', 'Archive Account', 'Confirm deactivation? Your data will be kept for historical persistence.', 'Deactivate My Account')">
          Archive & Deactivate
        </button>
      </div>
    </div>
  <% end %>
</div>