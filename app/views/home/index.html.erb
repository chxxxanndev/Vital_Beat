<div class="home-wrap">

  <!-- Top greeting bar -->
  <div class="home-topbar">
    <div>
      <p class="home-greeting">Good day,</p>
      <h1 class="home-name"><%= current_user.name.split(" ").first %>!</h1>
    </div>
  </div>

  <!-- Stat cards -->
  <div class="home-stats">
    <div class="home-stat-card anim-up delay-1">
      <div class="home-stat-icon" style="background: #f3e8ff;">
        <i class="fa-solid fa-heart-pulse" style="color: #7b2d5e;"></i>
      </div>
      <div>
        <p class="home-stat-label">Latest BPM</p>
        <p class="home-stat-val">-- <span class="home-stat-unit">bpm</span></p>
      </div>
    </div>

    <div class="home-stat-card anim-up delay-2">
      <div class="home-stat-icon" style="background: #fce7f3;">
        <i class="fa-solid fa-chart-line" style="color: #be185d;"></i>
      </div>
      <div>
        <p class="home-stat-label">Total Logs</p>
        <p class="home-stat-val">-- <span class="home-stat-unit">entries</span></p>
      </div>
    </div>

    <div class="home-stat-card anim-up delay-3">
      <div class="home-stat-icon" style="background: #ede9fe;">
        <i class="fa-solid fa-calendar-check" style="color: #6d28d9;"></i>
      </div>
      <div>
        <p class="home-stat-label">Last Logged</p>
        <p class="home-stat-val" style="font-size: 1rem;">--</p>
      </div>
    </div>

    <div class="home-stat-card anim-up delay-4">
      <div class="home-stat-icon" style="background: #fff1f2;">
        <i class="fa-solid fa-shield-heart" style="color: #e11d48;"></i>
      </div>
      <div>
        <p class="home-stat-label">Health Status</p>
        <p class="home-stat-val" style="font-size: 1rem;">--</p>
      </div>
    </div>
  </div>

  <!-- Main content grid -->
  <div class="home-grid">

    <!-- Welcome panel -->
    <div class="home-card anim-up delay-2">
      <div class="home-card-header">
        <h2 class="home-card-title"><i class="fa-solid fa-house me-2"></i>Welcome to VitalBeat</h2>
      </div>
      <div class="home-welcome-body">
        <div class="home-welcome-illustration">
          <i class="fa-solid fa-heart-pulse"></i>
        </div>
        <h3 class="home-welcome-heading">Your Heart Health Dashboard</h3>
        <p class="home-welcome-sub">
          Track, monitor, and understand your heart rate over time.
          This is your personal space to keep a professional record of your heart health journey.
        </p>
        <div class="home-welcome-badges">
          <span class="home-badge"><i class="fa-solid fa-lock me-1"></i>Secure</span>
          <span class="home-badge"><i class="fa-solid fa-bolt me-1"></i>Real-time</span>
          <span class="home-badge"><i class="fa-solid fa-shield-heart me-1"></i>Health Focused</span>
        </div>
      </div>
    </div>

    <!-- Side panel -->
    <div>

      <!-- Account info -->
      <div class="home-card mb-3 anim-up delay-3">
        <h2 class="home-card-title mb-3"><i class="fa-solid fa-circle-user me-2"></i>Account</h2>

        <div class="home-account-avatar">
          <%= current_user.name.split(" ").first[0].upcase %>
        </div>

        <div class="home-account-row">
          <span class="home-account-label">Name</span>
          <span class="home-account-val"><%= current_user.name.split(" ").first %></span>
        </div>
        <div class="home-account-row">
          <span class="home-account-label">Email</span>
          <span class="home-account-val"><%= current_user.email %></span>
        </div>
        <div class="home-account-row">
          <span class="home-account-label">Member since</span>
          <span class="home-account-val"><%= current_user.created_at.strftime("%b %d, %Y") %></span>
        </div>
        <div class="home-account-row" style="border-bottom: none;">
          <span class="home-account-label">Status</span>
          <span class="home-badge-green"><i class="fa-solid fa-circle me-1" style="font-size: 7px;"></i>Active</span>
        </div>
      </div>

      <!-- BPM guide -->
      <div class="home-card anim-up delay-4">
        <h2 class="home-card-title mb-3"><i class="fa-solid fa-circle-info me-2"></i>BPM Guide</h2>
        <div class="home-bpm-row">
          <span class="home-bpm-dot" style="background:#10b981;"></span>
          <span class="home-bpm-label">Normal</span>
          <span class="home-bpm-range">60 – 100 bpm</span>
        </div>
        <div class="home-bpm-row">
          <span class="home-bpm-dot" style="background:#f59e0b;"></span>
          <span class="home-bpm-label">Elevated</span>
          <span class="home-bpm-range">101 – 120 bpm</span>
        </div>
        <div class="home-bpm-row">
          <span class="home-bpm-dot" style="background:#e11d48;"></span>
          <span class="home-bpm-label">High</span>
          <span class="home-bpm-range">121+ bpm</span>
        </div>
        <div class="home-bpm-row">
          <span class="home-bpm-dot" style="background:#6d28d9;"></span>
          <span class="home-bpm-label">Low</span>
          <span class="home-bpm-range">Below 60 bpm</span>
        </div>
      </div>

    </div>
  </div>

</div>

