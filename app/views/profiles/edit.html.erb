<div class="home-wrap animate__animated animate__fadeIn">
  <div class="home-topbar">
    <div>
      <p class="home-greeting">Settings</p>
      <h1 class="home-name">Health Profile</h1>
    </div>
  </div>

  <% if @profile.errors.any? %>
    <div class="alert alert-danger shadow-sm border-0 rounded-3 mb-4 animate__animated animate__fadeInDown">
      <div class="d-flex align-items-center mb-2">
        <i class="fa-solid fa-circle-exclamation me-2"></i>
        <strong>Please fix the following:</strong>
      </div>
      <ul class="mb-0 ps-3 small">
        <% @profile.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% flash.each do |type, msg| %>
    <div class="alert alert-<%= type == 'notice' ? 'success' : 'danger' %> shadow-sm border-0 rounded-3 mb-4 animate__animated animate__fadeInDown">
      <div class="d-flex align-items-center">
        <i class="fa-solid <%= type == 'notice' ? 'fa-circle-check' : 'fa-circle-exclamation' %> me-2"></i>
        <%= msg %>
      </div>
    </div>
  <% end %>

  <!-- Account Card — full width -->
  <div class="home-card anim-up delay-1 mb-4">
    <h2 class="home-card-title mb-3"><i class="fa-solid fa-circle-user me-2"></i>Account</h2>
    <div class="d-flex align-items-center gap-4 flex-wrap">
      <div class="text-center">
        <% if @profile&.avatar&.attached? %>
          <%= image_tag @profile.avatar, class: "rounded-circle", style: "width:72px;height:72px;object-fit:cover;border:3px solid #f0e6ed;" %>
        <% else %>
          <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold text-white mx-auto" style="width:72px;height:72px;background:linear-gradient(135deg,#4a1c6e,#7b2d5e);font-size:1.5rem;">
            <%= current_user.name[0].upcase %>
          </div>
        <% end %>
      </div>
      <div class="flex-grow-1">
        <div class="fw-bold text-dark mb-1"><%= current_user.name %></div>
        <div class="small text-muted mb-2"><%= current_user.email %></div>
        <%= form_with model: @profile, url: update_profile_avatar_path, method: :patch, multipart: true do |f| %>
          <label class="btn btn-sm rounded-3 px-3" style="background:#f0e6ed;color:#7b2d5e;font-weight:600;font-size:0.8rem;cursor:pointer;">
            <i class="fa-solid fa-camera me-1"></i> Change Photo
            <%= f.file_field :avatar, class: "d-none", accept: "image/*", onchange: "this.form.requestSubmit()" %>
          </label>
        <% end %>
      </div>
      <div class="text-end">
        <div class="small text-muted">Registered</div>
        <div class="fw-semibold text-dark"><%= current_user.created_at.strftime("%b %Y") %></div>
      </div>
    </div>
  </div>

  <!-- Biometric Card — full width, with inline hint -->
  <div class="home-card shadow-sm border-0 rounded-4 p-4 p-md-5 anim-up delay-2">
    <div class="mb-4">
      <h4 class="fw-bold text-dark"><i class="fa-solid fa-user-doctor me-2 text-primary"></i>Biometric Information</h4>
      <p class="text-muted small">Update your details to ensure accurate heart rate zone analysis.</p>
    </div>

    <%= form_with model: @profile, url: profile_path, method: :patch do |f| %>
      <div class="row">
        <div class="col-md-6 mb-3">
          <%= f.label :age, "Age", class: "field-label" %>
          <%= f.number_field :age, class: "form-control", placeholder: "e.g. 25" %>
        </div>
        <div class="col-md-6 mb-3">
          <%= f.label :gender, "Biological Gender", class: "field-label" %>
          <%= f.select :gender, ['Male', 'Female', 'Other'], { prompt: 'Select...' }, class: "form-control" %>
        </div>
      </div>

      <div class="mb-3">
        <%= f.label :phone, "Emergency Contact Number", class: "field-label" %>
        <%= f.text_field :phone, class: "form-control", placeholder: "+63..." %>
      </div>

      <!-- "Why we need your age" moved here, inline with the form -->
      <div class="rounded-3 p-3 mb-4" style="background:#f9f4fc">
        <div class="d-flex align-items-start gap-2">
          <i class="fa-solid fa-circle-info mt-1" style="color:#7b2d5e;font-size:0.85rem;"></i>
          <p class="small text-muted mb-0">
            <strong class="text-dark">Why we need your age —</strong>
            The <strong>Maximum Heart Rate (MHR)</strong> formula is 220 minus your age.
            The system uses this to determine if you are in the "Cardio" or "Peak" zone during your logs.
          </p>
        </div>
      </div>

      <hr class="my-4 opacity-50">

      <div class="d-flex justify-content-between align-items-center">
        <span class="text-muted small">Information is used only for vital calculations.</span>
        <%= f.submit "Save Changes", class: "home-btn-primary" %>
      </div>
    <% end %>
  </div>

</div>